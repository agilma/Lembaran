# Authentication Secret for NextAuth / Auth.js (Generate with `openssl rand -base64 32`)
AUTH_SECRET=

# NextAuth Canonical URL
NEXTAUTH_URL=http://localhost:3000

# Multi-User Configuration (JSON array string of accounts with bcrypt hashed passwords)
# Example: USERS_CONFIG='[{"id":"user-1","email":"user1@example.com","name":"User One","role":"VIEWER","passwordHash":"$2a$10$..."}]'
USERS_CONFIG=

# Legacy Administrator Credentials (Fallback if USERS_CONFIG is not set)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_NAME=

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
